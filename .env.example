RADMON_SERIAL_PORT=COM15
RADMON_DETECTORS=
RADMON_BAUDRATE=2400
RADMON_SERIAL_TIMEOUT=2
RADMON_DB_HOST=localhost
RADMON_DB_PORT=3306
RADMON_DB_USER=root
RADMON_DB_PASSWORD=
RADMON_DB_NAME=ipradmon
RADMON_SERID=5201
RADMON_BUILDING=52
RADMON_ROOM=IS-1
RADMON_LOCATION=Gd.52
RADMON_WARNLEVEL=23
RADMON_ALARMLEVEL=25
RADMON_MAXIDLEMIN=30
RADMON_UNIT=µSv/h
RADMON_SAMPLE_INTERVAL=2
RADMON_REFRESH_INTERVAL=2
RADMON_DUMMY_MODE=normal

# Native Grafana. Port 3300 is intentionally stable: anonymous BRIN-LAN users see
# the monitoring playlist, while localhost:3300 keeps the normal admin login/editor.
RADMON_GRAFANA_URL=http://localhost:3300
RADMON_GRAFANA_PORT=3300
RADMON_GRAFANA_USER=admin
RADMON_GRAFANA_PASSWORD=admin
RADMON_GRAFANA_BIN=
# Docker is not part of the normal 6 GB production runtime. Set to 1 only for maintenance fallback.
RADMON_GRAFANA_DOCKER_FALLBACK=0
RADMON_GRAFANA_DB_HOST=host.docker.internal

RADMON_REPORT_DIR=!REPORT!
RADMON_SYNC_ENABLED=0
RADMON_CENTRAL_URL=
RADMON_CENTRAL_TOKEN=
RADMON_SYNC_BATCH_SIZE=100
RADMON_SYNC_TIMEOUT=10
RADMON_SYNC_INITIAL_LOOKBACK_HOURS=24
RADMON_RUNTIME_DIR=runtime
RADMON_LOG_DIR=logs
RADMON_SINGLE_INSTANCE_PORT=47652

# Central RadMon PC on the verified production LAN.
RADMON_CENTRAL_HOST=192.168.1.2

# Verified production ipradmon sources. The label before @ is a stable internal source_id.
# Credentials stay only in the local .env on PC .2.
# Collection is read-only except two explicit operator/admin workflows:
# (1) Administrator Station Properties writes approved device fields to its source first.
# (2) Alarm Response/Silence writes i_op/pic/note and changes i_flag 0 -> 1; ack is preserved.
# Source writes are enabled only when RADMON_LAN_ENABLED=1.
RADMON_LAN_ENABLED=0
RADMON_LAN_SOURCES=server50@192.168.1.50;server52@192.168.1.52;server38@192.168.1.38
RADMON_LAN_DB_PORT=3306
RADMON_LAN_DB_USER=
RADMON_LAN_DB_PASSWORD=
RADMON_LAN_DB_NAME=ipradmon

# Realtime vrecent + alarm polling.
RADMON_LAN_POLL_INTERVAL=2
RADMON_LAN_OFFLINE_AFTER_FAILURES=3

# Historical measurement backfill runs separately from realtime.
# Each source imports one detector per turn, then rotates to the next detector.
RADMON_BACKFILL_ENABLED=1
RADMON_BACKFILL_BATCH_SIZE=500
RADMON_BACKFILL_INTERVAL=2

# Legacy/maintenance batch size used by archive drain operations.
RADMON_LAN_BATCH_SIZE=1000

# Leave empty unless the same production SERID is intentionally shared by compatible sources.
RADMON_SHARED_SERIDS=

# Quarterly central archive lifecycle. Calendar boundaries use WIB.
RADMON_ARCHIVE_ENABLED=1
RADMON_ARCHIVE_DIR=archives
RADMON_ARCHIVE_TIMEZONE=Asia/Jakarta
RADMON_ARCHIVE_MIN_RETENTION_YEARS=5
RADMON_ARCHIVE_CHECK_INTERVAL=60

# Multi-user security store. Passwords/PINs are stored as salted hashes.
RADMON_SECURITY_DB=runtime/radmon-security.db
# Headless production has no bootstrap dialog. Fill all three values for the first
# installation only; after the Administrator exists they can be removed from .env.
RADMON_BOOTSTRAP_ADMIN_USER=
RADMON_BOOTSTRAP_ADMIN_PASSWORD=
RADMON_BOOTSTRAP_ADMIN_PIN=

# Browser/API session cookie. Set to 1 when served behind HTTPS.
RADMON_WEB_COOKIE_SECURE=0

# Optional WhatsApp alarm notifications (disabled by default).
RADMON_WHATSAPP_ENABLED=0
RADMON_WHATSAPP_GROUP=Alarm_Radmon
RADMON_WHATSAPP_PROFILE=runtime/whatsapp-profile
RADMON_WHATSAPP_DRIVER=
RADMON_WHATSAPP_INTERVAL=20
