RADMON_SERIAL_PORT=COM15
RADMON_DETECTORS=
RADMON_BAUDRATE=2400
RADMON_SERIAL_TIMEOUT=2
RADMON_DB_HOST=localhost
RADMON_DB_PORT=3306
RADMON_DB_USER=root
RADMON_DB_PASSWORD=
RADMON_DB_NAME=ipradmon
RADMON_SERID=5201
RADMON_BUILDING=52
RADMON_ROOM=IS-1
RADMON_LOCATION=Gd.52
RADMON_WARNLEVEL=23
RADMON_ALARMLEVEL=25
RADMON_MAXIDLEMIN=30
RADMON_UNIT=µSv/h
RADMON_SAMPLE_INTERVAL=2
RADMON_REFRESH_INTERVAL=2
RADMON_DUMMY_MODE=normal
RADMON_GRAFANA_URL=http://localhost:3000/d/radmon-radiation-monitoring/radiation-monitoring?orgId=1&refresh=2s&kiosk=tv
RADMON_GRAFANA_PORT=3300
RADMON_GRAFANA_USER=admin
RADMON_GRAFANA_PASSWORD=admin
RADMON_GRAFANA_BIN=
RADMON_GRAFANA_DB_HOST=host.docker.internal
RADMON_REPORT_DIR=!REPORT!
RADMON_SYNC_ENABLED=0
RADMON_CENTRAL_URL=
RADMON_CENTRAL_TOKEN=
RADMON_SYNC_BATCH_SIZE=100
RADMON_SYNC_TIMEOUT=10
RADMON_SYNC_INITIAL_LOOKBACK_HOURS=24
RADMON_RUNTIME_DIR=runtime
RADMON_LOG_DIR=logs
RADMON_SINGLE_INSTANCE_PORT=47652

# Central LAN aggregation (PC3). Keep production credentials only in local .env.
RADMON_LAN_ENABLED=0
RADMON_LAN_SOURCES=gd50@192.168.1.50;gd52@192.168.1.52;gd38@192.168.1.38
RADMON_LAN_DB_PORT=3306
RADMON_LAN_DB_USER=
RADMON_LAN_DB_PASSWORD=
RADMON_LAN_DB_NAME=ipradmon
RADMON_LAN_BATCH_SIZE=1000
RADMON_LAN_POLL_INTERVAL=2

# Multi-user security store. Passwords/PINs are stored as salted hashes.
RADMON_SECURITY_DB=runtime/radmon-security.db
RADMON_BOOTSTRAP_ADMIN_USER=
RADMON_BOOTSTRAP_ADMIN_PASSWORD=
RADMON_BOOTSTRAP_ADMIN_PIN=

# Browser/API session cookie. Set to 1 when served behind HTTPS.
RADMON_WEB_COOKIE_SECURE=0

# Optional WhatsApp alarm notifications (disabled by default).
RADMON_WHATSAPP_ENABLED=0
RADMON_WHATSAPP_GROUP=Alarm_Radmon
RADMON_WHATSAPP_PROFILE=runtime/whatsapp-profile
RADMON_WHATSAPP_DRIVER=
RADMON_WHATSAPP_INTERVAL=20
